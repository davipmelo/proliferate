rules_version = '2';

// Regras do Proliferate V2:
// - /userData/{uid} (e subcoleções chunks/images): somente o dono lê e escreve.
// - /usernames/{nome}: público para leitura (verificar disponibilidade); contém só uid + nome de usuário.
//   O e-mail nunca é gravado no Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    match /userData/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && name.matches('^[a-z0-9_.-]{3,24}$')
        && request.resource.data.username.lower() == name;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
