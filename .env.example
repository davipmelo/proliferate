# Firebase (opcional) — sincronização entre dispositivos.
# 1. Crie um projeto em https://console.firebase.google.com
# 2. Authentication > Método de login > ative "E-mail/senha"
# 3. Firestore Database > Criar banco de dados (modo produção) e publique firestore.rules
# 4. Configurações do projeto > Seus apps > Web: copie os valores abaixo
# Você também pode colar a configuração direto na interface (menu do usuário).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Proxy CORS do MPCFill (Cloudflare Worker em worker/index.js)
VITE_MPCFILL_PROXY=https://mpcfill-proxy.anancinho.workers.dev
